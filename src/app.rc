#include <winver.h>
#include "version.h"

1 ICON "app.ico"

// Интерфейс (папка web), упакованный tools/pack-web.ps1
101 RCDATA "../build/web.bin"

VS_VERSION_INFO VERSIONINFO
FILEVERSION CMDM_VERSION_MAJOR, CMDM_VERSION_MINOR, CMDM_VERSION_PATCH, 0
PRODUCTVERSION CMDM_VERSION_MAJOR, CMDM_VERSION_MINOR, CMDM_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "ООО «Аутсорсинг трейд»"
            VALUE "FileDescription", "CMD Manager"
            VALUE "FileVersion", CMDM_VERSION_STR
            VALUE "InternalName", "CMDManager"
            VALUE "LegalCopyright", "MIT License, itradmin.ru"
            VALUE "OriginalFilename", "CMDManager.exe"
            VALUE "ProductName", "CMD Manager"
            VALUE "ProductVersion", CMDM_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
